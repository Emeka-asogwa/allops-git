name: Manual Trigger
on:
  push:
    branches:
      - main
      - dev
  pull_request:
    branches:
      - main
permissions:
  contents: read
  pull-requests: write
  actions: write
  # workflow_dispatch:
  #   inputs:
  #     logLevel:
  #       description: "Log level"
  #       required: true
  #       default: "warning"
  #       type: choice
  #       options:
  #         - info
  #         - warning
  #         - debug
jobs:
  Build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v2
      - name: Run a one-line script
        run: echo Hello from Allops Organization
